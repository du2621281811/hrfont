# HR-Font root — one clone for collaborators.

# Heavy artifacts stay outside Git (dirs or local symlinks).
/data/fontdiffuser*
/data/font
/data/hrfont_bank
/runs/
/logs/
/artifacts/*
!/artifacts/e12/
/artifacts/e12/fonts/
/artifacts/e12/fonts_s3/
/artifacts/e12/.work/

# Review page large regenerable assets (keep bbox_explain + proto_DF_compare in Git)
/data/cn2west_v2_abc_review/proto_DF_script_review/
/data/cn2west_v2_abc_review/screen_v2b/

# p649 review: keep JSON decisions + training_map; skip regenerable previews
/data/p649_v2a_review/font_check_cards/
/data/p649_v2a_review/sheet_preview/
/data/p649_v2a_review/compare260_sheet.png
/data/p649_v2a_layers/sheet_preview/
/paper/iclr2027_hrfont_overleaf/

# Never commit model weights (even if someone places them under code/).
**/ckpt/
**/*.pt
**/*.pth

**/__pycache__/
**/*.py[cod]
**/.DS_Store
**/.ipynb_checkpoints/
*.tmp
*.log
*.zip
reports/pm_sync_log.jsonl
code/**/ckpt

# Live training-machine symlink into runs/viz (collaborators use reports/e1_ft_v2_dashboard)
/data/e1_ft_v2_dashboard
/data/f123_dashboard
/data/e1_formal_eval
