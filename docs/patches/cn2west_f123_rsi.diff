+class StyleRSIUpBlockIdentitySafe(nn.Module):
+    """RSI up block whose skip pathway is exactly identity at initialisation.
+
+        warped   = DeformConv(skip, offset)
+        skip_out = skip + zero_conv(warped - skip)
+
+    `zero_conv` is a 1x1 conv with zero weight and bias, so at step 0 the block is
+    element-wise equal to F0's `StyleUpBlockNoRSI` in any precision -- unlike a
+    zero-offset DeformConv, which still applies a learned 3x3 kernel to the skip.
+
+    `rsi_gain()` (mean |zero_conv.weight|) is a scalar read-out of how much RSI the
+    arm actually ended up using; log it instead of inferring RSI usage from metrics.
+    """
+
+    def __init__(
+        self,
+        in_channels: int,
+        out_channels: int,
+        prev_output_channel: int,
+        temb_channels: int,
+        dropout: float = 0.0,
+        num_layers: int = 1,
+        resnet_eps: float = 1e-6,
+        resnet_time_scale_shift: str = "default",
+        resnet_act_fn: str = "swish",
+        resnet_groups: int = 32,
