+        resnets = []
+        attentions = []
+        sc_interpreter_offsets = []
+        dcn_deforms = []
+        zero_convs = []
+
+        self.attention_type = attention_type
+        self.attn_num_head_channels = attn_num_head_channels
+        self.upblock_index = upblock_index
+        # Set False to bypass the RSI branch entirely (used by the step-0 parity gate).
+        self.rsi_enabled = True
+
+        for i in range(num_layers):
+            res_skip_channels = in_channels if (i == num_layers - 1) else out_channels
+            resnet_in_channels = prev_output_channel if i == 0 else out_channels
+
+            sc_interpreter_offsets.append(
+                OffsetRefStrucInter(
+                    res_in_channels=res_skip_channels,
