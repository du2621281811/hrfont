+                    num_groups=resnet_groups,
+                )
+            )
+            dcn_deforms.append(
+                DeformConv2d(
+                    in_channels=res_skip_channels,
+                    out_channels=res_skip_channels,
+                    kernel_size=(3, 3),
+                    stride=1,
+                    padding=1,
+                    dilation=1,
+                )
